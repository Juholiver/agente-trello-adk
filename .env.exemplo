# Copie este arquivo para .env e preencha com os seus valores.
# O arquivo .env NUNCA deve ser enviado ao Git.

# --- Google AI Studio (Gemini) ---
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=sua_chave_do_gemini_aqui

# --- Trello ---
# https://trello.com/power-ups/admin
TRELLO_API_KEY=sua_chave_api_trello_aqui
TRELLO_API_SECRET=seu_segredo_trello_aqui
TRELLO_TOKEN=seu_token_trello_aqui

# Nome exato do seu quadro (precisa ter as listas:
# "A fazer", "Em andamento" e "Concluído")
TRELLO_BOARD_NAME=DIO
